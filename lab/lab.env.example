# Copy to lab/lab.env or run scripts/generate-lab-env.sh.  This file is sourced
# by bash, so keep values on one line and quote values containing whitespace.

# Pinned OpenStack baseline.  Update these together, never independently.
OPENSTACK_RELEASE=stable/2025.2
DEVSTACK_REPOSITORY=https://opendev.org/openstack/devstack.git
DEVSTACK_REF=92e864aa017f61e911a8ce3976e828fa5b750ded
OCTAVIA_REF=ddaa9172fb68e66f13ea0f8f0a26bcbd9b0479cb
OVN_OCTAVIA_PROVIDER_REF=1c17bfe45fff4277165f9e580eb3f2f64c048a83

# Required AIO host settings.  PUBLIC_INTERFACE should be a dedicated provider
# NIC; do not select the interface carrying the only management connection.
HOST_IP=
PUBLIC_INTERFACE=
MGMT_ALLOWED_CIDR=

# Lab addressing from docs/lab/LAB_DESIGN.md.
PUBLIC_NETWORK_NAME=public
PUBLIC_CIDR=172.24.4.0/24
PUBLIC_GATEWAY=172.24.4.1
PUBLIC_POOL_START=172.24.4.100
PUBLIC_POOL_END=172.24.4.199
LB_NETWORK_NAME=lb-net
LB_SUBNET_NAME=lb-subnet
LB_CIDR=10.20.0.0/24
LB_GATEWAY=10.20.0.1
LOXILB_FIXED_IP=10.20.0.10
BACKEND1_FIXED_IP=10.20.0.21
BACKEND2_FIXED_IP=10.20.0.22
CLIENT_FIXED_IP=10.20.0.30
LOXILB_VIP=10.20.0.100
OCTAVIA_MGMT_CIDR=172.31.0.0/24
OCTAVIA_MGMT_POOL_START=172.31.0.2
OCTAVIA_MGMT_POOL_END=172.31.0.200

# An explicitly downloaded qcow2 image and its SHA-256.  The bootstrap script
# refuses an image whose checksum does not match.
LAB_IMAGE_NAME=ubuntu-24.04-lab
LAB_IMAGE_FILE=
LAB_IMAGE_SHA256=
LAB_SSH_KEY_NAME=lab-key
LAB_SSH_PUBLIC_KEY_FILE=
LAB_SSH_PRIVATE_KEY_FILE=
LAB_SSH_USER=ubuntu

# Set only when using clouds.yaml.  Leave empty to use the existing OS_* env.
LAB_OS_CLOUD=

# Release tag or immutable digest; never use :latest for a recorded baseline.
LOXILB_IMAGE=ghcr.io/loxilb-io/loxilb:v0.9.8

# Generated locally by scripts/generate-lab-env.sh.  Never commit populated
# values.  DevStack is a disposable development environment, not production.
LAB_ADMIN_PASSWORD=
LAB_DATABASE_PASSWORD=
LAB_RABBIT_PASSWORD=
LAB_SERVICE_PASSWORD=
LAB_SERVICE_TOKEN=
LAB_OCTAVIA_HEALTH_KEY=
